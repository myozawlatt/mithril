# Copy to .env.local (and set the same in Vercel). From Supabase:
# Project Settings → API (URL) and API Keys (publishable key, or the legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only for `npm run seed` on your machine. Secret key (or legacy service_role key):
# it bypasses row-level security. Never prefix it with NEXT_PUBLIC_ or add it to Vercel.
SUPABASE_SECRET_KEY=sb_secret_...
